string stroca = Console.ReadLine();
char symbol = Convert.ToChar(Console.ReadLine());
string result = "";
int count = 0;

foreach (char c in stroca)
{
    if (c == symbol)
    {
        count++;
        result += char.ToUpper(symbol);
    }
    else
    {
        result += char.ToLower(c);
    }
}

Console.WriteLine(count);
Console.WriteLine(result);


